{{!
    @template tiny_media/insert_image_modal_details

    Insert image details body template.

    Example context (json):
    {
        "elementid": "exampleId",
        "alt": "Image description",
        "presentation": true,
        "width": 600,
        "height": 400,
        "customStyle": "",
        "sizecustomhelpicon": {
            "text": "Help text"
        }
    }

}}
<div class="tiny_image_details">
    <div class="tiny_image_preview_box">
        <div class="image-grid">
            {{#images}}
            <div class="image-preview-container" data-image-id="{{id}}">
                <img src="{{url}}" class="tiny_image_preview" alt="" role="presentation">
                <div class="image-controls">
                    <label class="custom-control">
                        <input type="checkbox" class="image-selected" checked>
                        <span>{{#str}}select_image, tiny_media{{/str}}</span>
                    </label>
                </div>
            </div>
            {{/images}}
        </div>
    </div>

    <div class="tiny_image_size_panel">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="batch-mode" checked>
            <label class="form-check-label" for="batch-mode">
                {{#str}}apply_to_all, tiny_media{{/str}}
            </label>
        </div>

        <div class="mb-3">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="imagesize" id="sizeoriginal" value="original" checked>
                <label class="form-check-label" for="sizeoriginal">{{#str}}sizeoriginal, tiny_media{{/str}}</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="imagesize" id="sizecustom" value="custom">
                <label class="form-check-label" for="sizecustom">{{#str}}sizecustom, tiny_media{{/str}}</label>
                {{#sizecustomhelpicon}}
                    {{>core/help_icon}}
                {{/sizecustomhelpicon}}
            </div>
        </div>

        <div class="tiny_image_size_custom d-none">
            <div class="form-group">
                <label for="width">{{#str}}width, tiny_media{{/str}}</label>
                <input type="text" class="form-control" id="width" name="width" value="{{width}}">
            </div>
            <div class="form-group">
                <label for="height">{{#str}}height, tiny_media{{/str}}</label>
                <input type="text" class="form-control" id="height" name="height" value="{{height}}">
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="constrain" checked>
                <label class="form-check-label" for="constrain">{{#str}}constrain, tiny_media{{/str}}</label>
            </div>
        </div>
    </div>

    <div class="tiny_image_accessibility_panel">
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="presentation" name="presentation" {{#presentation}}checked{{/presentation}}>
            <label class="form-check-label" for="presentation">{{#str}}presentation, tiny_media{{/str}}</label>
        </div>
        <div class="form-group">
            <label for="alt">{{#str}}enteralt, tiny_media{{/str}}</label>
            <input type="text" class="form-control" id="alt" name="alt" value="{{alt}}" {{#presentation}}disabled{{/presentation}}>
            <div class="form-text text-muted">
                <span id="currentcount">0</span>/1024
            </div>
        </div>
        <div class="alert alert-warning tiny_image_alt_warning d-none">
            {{#str}}presentationoraltrequired, tiny_media{{/str}}
        </div>
    </div>
</div>

<style>
.image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
    max-height: 400px;
    overflow-y: auto;
    padding: 1rem;
}

.image-preview-container {
    position: relative;
    border: 1px solid #ddd;
    padding: 0.5rem;
    border-radius: 4px;
}

.image-preview-container img {
    width: 100%;
    height: auto;
    object-fit: contain;
}

.image-controls {
    margin-top: 0.5rem;
    padding: 0.25rem;
    background: rgba(255, 255, 255, 0.9);
}
</style>
